{
  "name": "@jpowersdev/effect-documents",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Versioned Markdown documents and anchored review, built on Effect and effect-delta",
  "homepage": "https://github.com/jpowersdev/effect-documents",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpowersdev/effect-documents.git"
  },
  "bugs": {
    "url": "https://github.com/jpowersdev/effect-documents/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "documents",
    "markdown",
    "review"
  ],
  "keywords": [
    "typescript",
    "effect",
    "documents",
    "markdown",
    "review"
  ],
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "doctest": "vitest run --config vitest.docs.ts",
    "test-types": "tstyche",
    "build": "tsc -p tsconfig.build.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "prepack": "pnpm build",
    "lint": "node scripts/format-examples.mjs --check && oxlint && dprint check && dprint check --config site/dprint.json",
    "lint-fix": "node scripts/format-examples.mjs && oxlint --fix && dprint fmt && dprint fmt --config site/dprint.json",
    "docgen": "docgen",
    "docs:dev": "pnpm docgen && pnpm --filter ./site dev",
    "docs:build": "pnpm docgen && pnpm --filter ./site build",
    "prepare": "effect-tsgo patch --typescript",
    "pack-check": "bash scripts/pack-check.sh"
  },
  "peerDependencies": {
    "effect": "^4.1.1",
    "@jpowersdev/effect-delta": "^0.1.0"
  },
  "devDependencies": {
    "@babel/cli": "8.0.6",
    "@babel/core": "8.0.7",
    "@babel/parser": "8.0.10",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/docgen": "4.1.1",
    "@effect/doctest": "4.1.1",
    "@effect/platform-node": "4.1.1",
    "@effect/sql-d1": "4.1.1",
    "@effect/sql-pglite": "4.1.1",
    "@effect/sql-sqlite-node": "4.1.1",
    "@effect/tsgo": "0.63.0",
    "@effect/vitest": "4.1.1",
    "@types/node": "24.19.2",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "dprint": "0.60.1",
    "effect": "4.1.1",
    "@jpowersdev/effect-delta": "0.1.0",
    "miniflare": "5.20260925.0-alpha",
    "oxlint": "1.87.0",
    "tstyche": "7.2.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.18.0",
      "onFail": "download"
    }
  }
}
