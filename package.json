{
  "name": "effect-documents",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Versioned Markdown documents and anchored review, built on Effect and effect-delta",
  "homepage": "https://github.com/jpowersdev/effect-documents",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpowersdev/effect-documents.git"
  },
  "bugs": {
    "url": "https://github.com/jpowersdev/effect-documents/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "documents",
    "markdown",
    "review"
  ],
  "keywords": [
    "typescript",
    "effect",
    "documents",
    "markdown",
    "review"
  ],
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test-types": "tstyche",
    "build": "tsc -p tsconfig.build.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "prepack": "pnpm build",
    "lint": "oxlint && dprint check",
    "lint-fix": "oxlint --fix && dprint fmt",
    "prepare": "effect-tsgo patch --typescript",
    "pack-check": "bash scripts/pack-check.sh"
  },
  "peerDependencies": {
    "effect": "~4.0.6",
    "effect-delta": "^0.1.0"
  },
  "devDependencies": {
    "@babel/cli": "8.0.6",
    "@babel/core": "8.0.7",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/platform-node": "4.0.6",
    "@effect/sql-d1": "4.0.6",
    "@effect/sql-pglite": "4.0.6",
    "@effect/sql-sqlite-node": "4.0.6",
    "@effect/tsgo": "0.50.0",
    "@effect/vitest": "4.0.6",
    "@types/node": "24.19.2",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "dprint": "0.60.1",
    "effect": "4.0.6",
    "effect-delta": "file:../effect-delta/packages/delta",
    "miniflare": "5.20260925.0-alpha",
    "oxlint": "1.87.0",
    "tstyche": "7.2.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.18.0",
      "onFail": "download"
    }
  }
}
